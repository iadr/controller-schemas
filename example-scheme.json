{
  "controller": "xbox",
  "mappings": {
    "south": {
      "press": {
        "action": "Jump",
        "description": "Character jumps"
      }
    },
    "east": {
      "press": {
        "action": "Slide",
        "description": "Quick slide"
      },
      "hold": {
        "action": "Crouch",
        "description": "Hold to crouch"
      }
    },
    "west": {
      "press": {
        "action": "Reload",
        "description": "Reload current weapon"
      },
      "hold": {
        "action": "Reload All",
        "description": "Reload all weapons"
      }
    },
    "north": {
      "press": {
        "action": "Switch Weapon",
        "description": "Toggle between primary and secondary"
      }
    },
    "leftButton": {
      "press": {
        "action": "Grenade",
        "description": "Throw grenade"
      }
    },
    "rightButton": {
      "press": {
        "action": "Melee",
        "description": "Melee attack"
      }
    },
    "leftTrigger": {
      "hold": {
        "action": "Aim",
        "description": "Aim down sights"
      }
    },
    "rightTrigger": {
      "press": {
        "action": "Fire",
        "description": "Shoot weapon"
      }
    },
    "leftStick": {
      "press": {
        "action": "Sprint",
        "description": "Click to toggle sprint"
      }
    },
    "rightStick": {
      "press": {
        "action": "Change View",
        "description": "Switch camera view"
      }
    },
    "dPadUp": {
      "press": {
        "action": "Ping",
        "description": "Mark location"
      }
    },
    "dPadDown": {
      "press": {
        "action": "Holster",
        "description": "Put weapon away"
      }
    },
    "dPadLeft": {
      "press": {
        "action": "Previous Gadget",
        "description": "Cycle gadgets backward"
      }
    },
    "dPadRight": {
      "press": {
        "action": "Next Gadget",
        "description": "Cycle gadgets forward"
      }
    },
    "start": {
      "press": {
        "action": "Pause",
        "description": "Open pause menu"
      }
    },
    "select": {
      "press": {
        "action": "Inventory",
        "description": "Open inventory"
      }
    }
  }
}
